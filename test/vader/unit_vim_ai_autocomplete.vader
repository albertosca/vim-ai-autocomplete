" UN-000a to UN-000j: the foundation of the N-model config -- DefaultModels(),
" ResolveActiveModels(), FindModelByName(). Replaces the has_gemini/has_claude
" pair of booleans with a configurable list (see the spec at
" docs/superpowers/specs/2026-07-21-vim-ai-autocomplete-multi-model-design.md).

Execute (UN-000a DefaultModels: two models, gemini and claude, with the current model_ids):
  let models = vim_ai_autocomplete#DefaultModels()
  AssertEqual 2, len(models)
  AssertEqual 'gemini', models[0].name
  AssertEqual 'gemini', models[0].family
  AssertEqual 'gemini-3.1-flash-lite', models[0].model_id
  AssertEqual 'GEMINI_API_KEY', models[0].api_key_env
  AssertEqual 'claude', models[1].name
  AssertEqual 'anthropic', models[1].family
  AssertEqual 'claude-sonnet-4-5-20250929', models[1].model_id
  AssertEqual 'ANTHROPIC_API_KEY', models[1].api_key_env

Execute (UN-000b ResolveActiveModels: filters by an env var that is present and non-empty):
  let $UN_TEST_KEY_A = 'valor-a'
  if exists('$UN_TEST_KEY_B')
    unlet $UN_TEST_KEY_B
  endif
  let models = [
        \ {'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'UN_TEST_KEY_A'},
        \ {'name': 'b', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'UN_TEST_KEY_B'},
        \ ]
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels(models)
  AssertEqual 1, len(active)
  AssertEqual 'a', active[0].name
  AssertEqual [], warnings
After:
  unlet $UN_TEST_KEY_A

Execute (UN-000c ResolveActiveModels: an empty env var (set but an empty string) does NOT count as present):
  let $UN_TEST_KEY_EMPTY = ''
  let models = [{'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'UN_TEST_KEY_EMPTY'}]
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels(models)
  AssertEqual [], active
After:
  unlet $UN_TEST_KEY_EMPTY

Execute (UN-000d ResolveActiveModels: no env var present -> empty active list):
  let models = [{'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'UN_TEST_KEY_NUNCA_EXISTE'}]
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels(models)
  AssertEqual [], active
  AssertEqual [], warnings

Execute (UN-000e ResolveActiveModels: every env var present -> all active, in the same order):
  let $UN_TEST_KEY_A = 'a'
  let $UN_TEST_KEY_B = 'b'
  let $UN_TEST_KEY_C = 'c'
  let models = [
        \ {'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'UN_TEST_KEY_A'},
        \ {'name': 'b', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'UN_TEST_KEY_B'},
        \ {'name': 'c', 'family': 'anthropic', 'model_id': 'z', 'api_key_env': 'UN_TEST_KEY_C'},
        \ ]
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels(models)
  AssertEqual ['a', 'b', 'c'], map(copy(active), 'v:val.name')
After:
  unlet $UN_TEST_KEY_A
  unlet $UN_TEST_KEY_B
  unlet $UN_TEST_KEY_C

Execute (UN-000f ResolveActiveModels: duplicate name -> only the first occurrence gets in, with a warning):
  let $UN_TEST_KEY_A = 'a'
  let $UN_TEST_KEY_A2 = 'a2'
  let models = [
        \ {'name': 'dup', 'family': 'gemini', 'model_id': 'primeiro', 'api_key_env': 'UN_TEST_KEY_A'},
        \ {'name': 'dup', 'family': 'gemini', 'model_id': 'segundo', 'api_key_env': 'UN_TEST_KEY_A2'},
        \ ]
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels(models)
  AssertEqual 1, len(active)
  AssertEqual 'primeiro', active[0].model_id
  AssertEqual 1, len(warnings)
  Assert warnings[0] =~# 'dup', 'the warning should mention the duplicate name'
After:
  unlet $UN_TEST_KEY_A
  unlet $UN_TEST_KEY_A2

Execute (UN-000g ResolveActiveModels: empty list -> empty active list, no warnings):
  let [active, warnings] = vim_ai_autocomplete#ResolveActiveModels([])
  AssertEqual [], active
  AssertEqual [], warnings

Execute (UN-000h FindModelByName: finds it by name):
  let models = [{'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'X'}]
  let found = vim_ai_autocomplete#FindModelByName(models, 'a')
  AssertEqual 'x', found.model_id

Execute (UN-000i FindModelByName: the name does not exist -> v:null):
  let models = [{'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'X'}]
  AssertEqual v:null, vim_ai_autocomplete#FindModelByName(models, 'does-not-exist')

Execute (UN-000j FindModelByName: empty list -> v:null):
  AssertEqual v:null, vim_ai_autocomplete#FindModelByName([], 'qualquer')

Execute (UN-000k ActiveModels: uses g:vim_ai_autocomplete_models when defined, instead of the default):
  let $UN_TEST_ACTIVE_KEY = 'valor'
  let g:vim_ai_autocomplete_models = [{'name': 'custom', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'UN_TEST_ACTIVE_KEY'}]
  let active = vim_ai_autocomplete#ActiveModels()
  AssertEqual ['custom'], map(copy(active), 'v:val.name')
After:
  if exists('g:vim_ai_autocomplete_models')
    unlet g:vim_ai_autocomplete_models
  endif
  if exists('$UN_TEST_ACTIVE_KEY')
    unlet $UN_TEST_ACTIVE_KEY
  endif

Execute (UN-000l ActiveModels: with no g:vim_ai_autocomplete_models defined, uses the default):
  if exists('g:vim_ai_autocomplete_models')
    unlet g:vim_ai_autocomplete_models
  endif
  let $GEMINI_API_KEY_BACKUP_UN000L = exists('$GEMINI_API_KEY') ? $GEMINI_API_KEY : ''
  let $GEMINI_API_KEY = 'fake-for-testing'
  if exists('$ANTHROPIC_API_KEY')
    unlet $ANTHROPIC_API_KEY
  endif
  let active = vim_ai_autocomplete#ActiveModels()
  AssertEqual ['gemini'], map(copy(active), 'v:val.name')
After:
  if !empty($GEMINI_API_KEY_BACKUP_UN000L)
    let $GEMINI_API_KEY = $GEMINI_API_KEY_BACKUP_UN000L
  endif
  unlet $GEMINI_API_KEY_BACKUP_UN000L

Execute (UN-000m ActiveModels: a config with a duplicate name throws no exception, returns the deduplicated list):
  let $UN_TEST_DUP_KEY_A = 'a'
  let $UN_TEST_DUP_KEY_B = 'b'
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'dup', 'family': 'gemini', 'model_id': 'primeiro', 'api_key_env': 'UN_TEST_DUP_KEY_A'},
        \ {'name': 'dup', 'family': 'gemini', 'model_id': 'segundo', 'api_key_env': 'UN_TEST_DUP_KEY_B'},
        \ ]
  let threw = 0
  let active = []
  try
    let active = vim_ai_autocomplete#ActiveModels()
  catch
    let threw = 1
  endtry
  AssertEqual 0, threw, 'ActiveModels() should NOT throw just because ResolveActiveModels returned warnings'
  AssertEqual 1, len(active)
  AssertEqual 'primeiro', active[0].model_id
After:
  if exists('g:vim_ai_autocomplete_models')
    unlet g:vim_ai_autocomplete_models
  endif
  unlet $UN_TEST_DUP_KEY_A
  unlet $UN_TEST_DUP_KEY_B

" UN-001 to UN-004: vim_ai_autocomplete#ResolveDefaultModel() -- generalises
" the old ResolveProvider(has_gemini, has_claude) to N models.

Execute (UN-001 ResolveDefaultModel: 2+ active models -> first of the active list, no warning):
  let all = vim_ai_autocomplete#DefaultModels()
  let active = [all[0], all[1]]
  let [name, level, message] = vim_ai_autocomplete#ResolveDefaultModel(all, active)
  AssertEqual 'gemini', name
  AssertEqual v:null, level
  AssertEqual v:null, message

Execute (UN-002 ResolveDefaultModel: only 1 active model -> that one, with a warning mentioning its name):
  let all = vim_ai_autocomplete#DefaultModels()
  let active = [all[0]]
  let [name, level, message] = vim_ai_autocomplete#ResolveDefaultModel(all, active)
  AssertEqual 'gemini', name
  AssertEqual 'warn', level
  Assert message =~# 'gemini', 'the message should mention the name of the only active model'

Execute (UN-003 ResolveDefaultModel: no active model -> error, no name, the message cites the configured env vars):
  let all = vim_ai_autocomplete#DefaultModels()
  let [name, level, message] = vim_ai_autocomplete#ResolveDefaultModel(all, [])
  AssertEqual v:null, name
  AssertEqual 'error', level
  Assert message =~# 'GEMINI_API_KEY', 'the message should mention GEMINI_API_KEY'
  Assert message =~# 'ANTHROPIC_API_KEY', 'the message should mention ANTHROPIC_API_KEY'

Execute (UN-004 ResolveDefaultModel: with 3 models configured and only 1 active -> the error message lists all 3):
  let all = [
        \ {'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'ENV_A'},
        \ {'name': 'b', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'ENV_B'},
        \ {'name': 'c', 'family': 'anthropic', 'model_id': 'z', 'api_key_env': 'ENV_C'},
        \ ]
  let [name, level, message] = vim_ai_autocomplete#ResolveDefaultModel(all, [])
  AssertEqual 'error', level
  Assert message =~# 'ENV_A', 'the message should cite ENV_A'
  Assert message =~# 'ENV_B', 'the message should cite ENV_B'
  Assert message =~# 'ENV_C', 'the message should cite ENV_C'

" UN-005 to UN-010: context, request assembly, response parsing. None of
" these tests makes a real network call -- only the pure functions.

Execute (UN-005 BuildContext: no truncation when it fits the cap):
  let ctx = vim_ai_autocomplete#BuildContext(['abc'], ['def'], 100)
  AssertEqual 'abc', ctx.before
  AssertEqual 'def', ctx.after

Execute (UN-006 BuildContext: truncates respecting 75/25 when it exceeds the cap):
  let long_before = repeat('x', 100)
  let ctx = vim_ai_autocomplete#BuildContext(split(long_before, '\zs'), ['y'], 40)
  AssertEqual 30, strchars(ctx.before)
  AssertEqual 1, strchars(ctx.after)

Execute (UN-007 BuildGeminiRequest: produces valid JSON with the prompt, including the text AFTER the cursor):
  let req = vim_ai_autocomplete#BuildGeminiRequest({'before': 'def foo(', 'after': ')'})
  let decoded = json_decode(req)
  Assert decoded.contents[0].parts[0].text =~# 'def foo(', 'the request should contain the before context'
  Assert decoded.contents[0].parts[0].text =~# ')', 'the request should contain the after context (FIM), otherwise the model duplicates what already exists'

Execute (UN-008 BuildClaudeRequest: produces valid JSON with the right model, including the text AFTER the cursor):
  let req = vim_ai_autocomplete#BuildClaudeRequest({'before': 'def foo(', 'after': ')'}, 'claude-sonnet-4-5-20250929')
  let decoded = json_decode(req)
  AssertEqual 'claude-sonnet-4-5-20250929', decoded.model
  Assert decoded.messages[0].content =~# 'def foo(', 'the request should contain the before context'
  Assert decoded.messages[0].content =~# 'AFTER THE CURSOR', 'the request should tell the model about the text after the cursor'

Execute (UN-009 ParseGeminiResponse: extracts the lines from the real API shape):
  let fake = json_encode({'candidates': [{'content': {'parts': [{'text': "line1\nline2"}]}}]})
  AssertEqual ['line1', 'line2'], vim_ai_autocomplete#ParseGeminiResponse(fake)

" UN-009a/b: a blocked candidate (e.g. a safety filter, finishReason
" SAFETY/RECITATION) comes back WITHOUT "content", or without "parts" -- a
" legitimate HTTP 200 response, just with no actual suggestion. Real finding
" from a live smoke test of the Neovim port on 2026-07-22: "attempt to index
" field 'parts' (a nil value)" -- the direct access
" data.candidates[0].content.parts[0] threw a Lua exception when
" content/parts are absent. The SAME bug (unguarded) was confirmed on the Vim
" side -- both were fixed together.
Execute (UN-009a ParseGeminiResponse: candidate with no "content" (blocked by a safety filter) -> empty list, no error):
  let fake = json_encode({'candidates': [{'finishReason': 'SAFETY'}]})
  AssertEqual [], vim_ai_autocomplete#ParseGeminiResponse(fake)

Execute (UN-009b ParseGeminiResponse: candidate with "content" but no "parts" -> empty list, no error):
  let fake = json_encode({'candidates': [{'content': {'role': 'model'}, 'finishReason': 'RECITATION'}]})
  AssertEqual [], vim_ai_autocomplete#ParseGeminiResponse(fake)

Execute (UN-010 ParseClaudeResponse: extracts the lines from the real API shape):
  let fake = json_encode({'content': [{'text': "lineA\nlineB\nlineC"}]})
  AssertEqual ['lineA', 'lineB', 'lineC'], vim_ai_autocomplete#ParseClaudeResponse(fake)

" UN-011 to UN-015: ShowSuggestion/ClearSuggestion/IsVisible -- introspection
" through prop_list(), without depending on a real screen or visual render.

Execute (UN-011 ShowSuggestion draws 1 prop per suggestion line):
  new
  call setline(1, 'def foo(')
  call cursor(1, 9)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'])
  AssertEqual 2, len(prop_list(1))
  AssertEqual 'def foo(', getline(1)
  call vim_ai_autocomplete#ClearSuggestion()
After:
  bdelete!

Execute (UN-012 ShowSuggestion does not change the real buffer content):
  new
  call setline(1, 'def foo(')
  call cursor(1, 9)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):'])
  AssertEqual 'def foo(', getline(1)
  call vim_ai_autocomplete#ClearSuggestion()
After:
  bdelete!

Execute (UN-013 IsVisible reflects the real state):
  new
  call setline(1, 'x')
  call cursor(1, 2)
  AssertEqual 0, vim_ai_autocomplete#IsVisible()
  call vim_ai_autocomplete#ShowSuggestion(['y'])
  AssertEqual 1, vim_ai_autocomplete#IsVisible()
  call vim_ai_autocomplete#ClearSuggestion()
  AssertEqual 0, vim_ai_autocomplete#IsVisible()
After:
  bdelete!

Execute (UN-014 ClearSuggestion removes ALL props on the line, not just one):
  new
  call setline(1, 'x')
  call cursor(1, 2)
  call vim_ai_autocomplete#ShowSuggestion(['line1', 'line2', 'line3'])
  AssertEqual 3, len(prop_list(1)), 'should have 3 props (1 per suggestion line)'
  call vim_ai_autocomplete#ClearSuggestion()
  AssertEqual 0, len(prop_list(1)), 'ClearSuggestion should remove them ALL, not only the first'
After:
  bdelete!

Execute (UN-015 ClearSuggestion uses the saved line, not the current cursor position):
  new
  call setline(1, ['line one', 'line two'])
  call cursor(1, 1)
  call vim_ai_autocomplete#ShowSuggestion(['suggestion'])
  AssertEqual 1, len(prop_list(1))
  " simulates the cursor having moved (CursorMovedI fires AFTER the movement)
  call cursor(2, 1)
  call vim_ai_autocomplete#ClearSuggestion()
  AssertEqual 0, len(prop_list(1)), 'should clear line 1 (where the suggestion was), not line 2 (where the cursor is now)'
After:
  bdelete!

" UN-016 to UN-017: vim_ai_autocomplete#BuildClaudeCommand() -- raw curl with
" a static ANTHROPIC_API_KEY only. `ant` was removed on 2026-07-20 (no billing
" advantage for this plugin's use case -- it bills the same per-token paid API
" credit the static key does, it only changes how you authenticate).

Execute (UN-016 BuildClaudeCommand: builds the curl command with the right key):
  let ctx = {'before': 'def foo(', 'after': ')'}
  let result = vim_ai_autocomplete#BuildClaudeCommand(ctx, 'claude-sonnet-4-5-20250929', 'sk-ant-fake123')
  AssertEqual 'curl', result[0]
  AssertEqual 'x-api-key: sk-ant-fake123', result[6]

Execute (UN-017 BuildClaudeCommand: correct endpoint, headers and body):
  let ctx = {'before': 'def foo(', 'after': ')'}
  let result = vim_ai_autocomplete#BuildClaudeCommand(ctx, 'claude-sonnet-4-5-20250929', 'chave')
  AssertEqual 'https://api.anthropic.com/v1/messages', result[4]
  Assert index(result, 'anthropic-version: 2023-06-01') >= 0
  let body_idx = index(result, '-d') + 1
  let decoded = json_decode(result[body_idx])
  AssertEqual 'claude-sonnet-4-5-20250929', decoded.model
  Assert decoded.messages[0].content =~# 'def foo(', 'the body should contain the context'

" UN-018 to UN-022: BuildGeminiCommand + FamilyHandler -- dispatch by API
" family (Gemini vs Anthropic Claude).

Execute (UN-018 BuildGeminiCommand: builds the curl command with the right endpoint and model_id):
  let ctx = {'before': 'def foo(', 'after': ')'}
  let result = vim_ai_autocomplete#BuildGeminiCommand(ctx, 'gemini-3.1-flash-lite', 'minha-chave')
  AssertEqual 'curl', result[0]
  Assert result[4] =~# 'gemini-3\.1-flash-lite', 'the endpoint should contain the model_id'
  Assert result[4] =~# 'key=minha-chave', 'the endpoint should contain the api key'

Execute (UN-019 BuildGeminiCommand: the body contains the context):
  let ctx = {'before': 'def foo(', 'after': ')'}
  let result = vim_ai_autocomplete#BuildGeminiCommand(ctx, 'gemini-3.1-flash-lite', 'chave')
  let body_idx = index(result, '-d') + 1
  let decoded = json_decode(result[body_idx])
  Assert decoded.contents[0].parts[0].text =~# 'def foo(', 'the body should contain the context'

Execute (UN-020 FamilyHandler: the "gemini" family returns BuildGeminiCommand + ParseGeminiResponse):
  let handler = vim_ai_autocomplete#FamilyHandler('gemini')
  AssertEqual function('vim_ai_autocomplete#BuildGeminiCommand'), handler.build_command
  AssertEqual function('vim_ai_autocomplete#ParseGeminiResponse'), handler.parse_response

Execute (UN-021 FamilyHandler: the "anthropic" family returns BuildClaudeCommand + ParseClaudeResponse):
  let handler = vim_ai_autocomplete#FamilyHandler('anthropic')
  AssertEqual function('vim_ai_autocomplete#BuildClaudeCommand'), handler.build_command
  AssertEqual function('vim_ai_autocomplete#ParseClaudeResponse'), handler.parse_response

Execute (UN-022 FamilyHandler: unknown family -> throws a clear exception):
  let threw = 0
  try
    call vim_ai_autocomplete#FamilyHandler('openai-does-not-exist')
  catch /unknown family/
    let threw = 1
  endtry
  AssertEqual 1, threw, 'should throw an exception mentioning "unknown family"'

" UN-024 to UN-028: vim_ai_autocomplete#AdjustSuggestionLines() -- fixes the
" case (confirmed real, reproducible 3/3 with gemini-3.1-flash-lite) where the
" first line of the suggestion arrives with no line break and no indentation
" when the context ends in ":" (a Python block opener).

Execute (UN-024 AdjustSuggestionLines inserts a line break and indentation when the context ends in a colon, python, expandtab):
  let lines = ['if n <= 1:', '        return n', '    else:', '        return fibonacci(n - 1) + fibonacci(n - 2)']
  let result = vim_ai_autocomplete#AdjustSuggestionLines(lines, 'def fibonacci(n):', 'python', 4, 1)
  AssertEqual [
        \ '',
        \ '    if n <= 1:',
        \ '        return n',
        \ '    else:',
        \ '        return fibonacci(n - 1) + fibonacci(n - 2)',
        \ ], result

Execute (UN-025 AdjustSuggestionLines leaves it alone when the context does NOT end in a colon (a normal same-line continuation)):
  let lines = ['a + b']
  let result = vim_ai_autocomplete#AdjustSuggestionLines(lines, '    return', 'python', 4, 1)
  AssertEqual ['a + b'], result

Execute (UN-026 AdjustSuggestionLines leaves it alone when the filetype is not python):
  let lines = ['if (n <= 1) {', '  return n;', '}']
  let result = vim_ai_autocomplete#AdjustSuggestionLines(lines, 'function fib(n) {', 'javascript', 2, 1)
  AssertEqual ['if (n <= 1) {', '  return n;', '}'], result

Execute (UN-027 AdjustSuggestionLines leaves it alone when the suggestion already came with a line break of its own):
  let lines = ['', '    if n <= 1:', '        return n']
  let result = vim_ai_autocomplete#AdjustSuggestionLines(lines, 'def fibonacci(n):', 'python', 4, 1)
  AssertEqual ['', '    if n <= 1:', '        return n'], result

Execute (UN-028 AdjustSuggestionLines uses a tab when noexpandtab):
  let lines = ['if n <= 1:', '        return n']
  let result = vim_ai_autocomplete#AdjustSuggestionLines(lines, 'def fibonacci(n):', 'python', 4, 0)
  AssertEqual ['', "\tif n <= 1:", '        return n'], result

Execute (UN-033 ExtractApiErrorMessage: extracts the message from a valid error body):
  let raw = '{"type":"error","error":{"type":"invalid_request_error","message":"algo deu errado"}}'
  AssertEqual 'algo deu errado', vim_ai_autocomplete#ExtractApiErrorMessage(raw)

Execute (UN-034 ExtractApiErrorMessage: empty string for invalid JSON or a missing error field):
  AssertEqual '', vim_ai_autocomplete#ExtractApiErrorMessage('not json')
  AssertEqual '', vim_ai_autocomplete#ExtractApiErrorMessage('{"candidates":[]}')

Execute (UN-035 DescribeCompletionFailure: a response with an API error -> reports the message, with the provider name):
  let raw = '{"error":{"message":"Your credit balance is too low to access the Anthropic API."}}'
  let message = vim_ai_autocomplete#DescribeCompletionFailure('claude', 1, raw)
  Assert message =~# 'claude', 'should mention the provider: ' . message
  Assert message =~# 'credit balance', 'should pass through the original API message: ' . message

Execute (UN-036 DescribeCompletionFailure: exit != 0 with no parseable error body -> a generic message with the code):
  let message = vim_ai_autocomplete#DescribeCompletionFailure('gemini', 7, 'something that is not json')
  Assert message =~# 'gemini', 'should mention the provider: ' . message
  Assert message =~# '7', 'should mention the exit code: ' . message

Execute (UN-037 DescribeCompletionFailure: exit 0 with no parseable error -> empty string, nothing to report):
  AssertEqual '', vim_ai_autocomplete#DescribeCompletionFailure('gemini', 0, '')

Execute (UN-038 ComputeTextOverlapLength: finds the overlap at the end of the suggestion):
  let lines = ['x, y)']
  AssertEqual 1, vim_ai_autocomplete#ComputeTextOverlapLength(lines, ')')

Execute (UN-039 ComputeTextOverlapLength: no overlap -> 0):
  let lines = ['x, y']
  AssertEqual 0, vim_ai_autocomplete#ComputeTextOverlapLength(lines, ')')

Execute (UN-040 ComputeTextOverlapLength: the whole suggestion just repeats what already exists -> overlap = full length):
  let lines = ['):', '    pass']
  AssertEqual 11, vim_ai_autocomplete#ComputeTextOverlapLength(lines, "):\n    pass")

Execute (UN-041 ComputeTextOverlapLength: partial multi-line overlap):
  let lines = ['return x', '}']
  AssertEqual 1, vim_ai_autocomplete#ComputeTextOverlapLength(lines, "}\nmore code after")

Execute (UN-042 ComputeTextOverlapLength: an empty list or empty after-text -> 0):
  AssertEqual 0, vim_ai_autocomplete#ComputeTextOverlapLength(['a', 'b'], '')
  AssertEqual 0, vim_ai_autocomplete#ComputeTextOverlapLength([], ')')

Execute (UN-043 SplitLinesAtCursor: splits the current line at the cursor column, never sending it whole to both sides):
  let [before, after] = vim_ai_autocomplete#SplitLinesAtCursor(['previous line'], 'def sum()', 9, ['next line'])
  AssertEqual ['previous line', 'def sum('], before
  AssertEqual [')', 'next line'], after

Execute (UN-044 SplitLinesAtCursor: cursor at column 1 (start of the line)):
  let [before, after] = vim_ai_autocomplete#SplitLinesAtCursor([], 'foo', 1, [])
  AssertEqual [''], before
  AssertEqual ['foo'], after

Execute (UN-045 SplitLinesAtCursor: cursor past the last character (end of the line)):
  let [before, after] = vim_ai_autocomplete#SplitLinesAtCursor([], 'foo', 4, [])
  AssertEqual ['foo'], before
  AssertEqual [''], after

Execute (UN-046 CountRedundantAfterChars: the suggestion closes the parenthesis opened before it -> the real ")" becomes redundant):
  AssertEqual 1, vim_ai_autocomplete#CountRedundantAfterChars('def sum(', "a, b):\n    return a + b", ')')

Execute (UN-047 CountRedundantAfterChars: the suggestion closes nothing opened before it -> nothing redundant):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('foo', 'bar', ')')

Execute (UN-048 CountRedundantAfterChars: "after" does not start with a closer -> plays it safe, returns 0):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('def sum(', 'a, b)', 'not_a_closer')

Execute (UN-049 CountRedundantAfterChars: several levels closed by the suggestion):
  AssertEqual 2, vim_ai_autocomplete#CountRedundantAfterChars('foo([', '])', '])')

Execute (UN-050 CountRedundantAfterChars: the suggestion opens and closes its own parenthesis -> leaves what already existed alone):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('foo(', 'bar(1, 2)', ')')

" UN-051 to UN-054: CountRedundantAfterChars with quotes (g:AutoPairs also
" fecha ' " ` -- simetricas, alternam em vez de empilhar tipo diferente).

Execute (UN-051 CountRedundantAfterChars: the suggestion closes the double quote opened before it -> the real quote becomes redundant):
  AssertEqual 1, vim_ai_autocomplete#CountRedundantAfterChars('name = "', 'John"', '"')

Execute (UN-052 CountRedundantAfterChars: the suggestion closes the single quote opened before it):
  AssertEqual 1, vim_ai_autocomplete#CountRedundantAfterChars("name = '", "John'", "'")

Execute (UN-053 CountRedundantAfterChars: mixes parentheses and quotes -- print("|") with a suggestion closing both):
  AssertEqual 2, vim_ai_autocomplete#CountRedundantAfterChars('print("', 'ola")', '")')

Execute (UN-054 CountRedundantAfterChars: a quote inside the suggestion that closes NOTHING opened before -> leaves it alone):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('foo(', '"bar"', ')')

" UN-055 to UN-058: cursor BEFORE the opening bracket itself (not inside the
" pair already opened) -- "before" has no pending bracket (depth 0), and the
" suggestion, unaware that the empty pair already exists in "after", writes
" its OWN complete version. Real finding on 2026-07-21 (def
" quicksort()/mergesort() with the cursor BEFORE the "(", not between the two
" parentheses -- a g:vim_ai_autocomplete_debug log confirmed depth_before=0,
" a:after='()' untouched, redundant_after=0 from both existing mechanisms):
" "def quicksort" plus the suggestion "(arr):" plus an untouched "()" gives
" "def quicksort(arr):()" -- the original empty pair is left over at the end.

Execute (UN-055 CountRedundantAfterChars: cursor before the opening bracket, suggestion writes its own pair -> the original empty pair becomes redundant):
  AssertEqual 2, vim_ai_autocomplete#CountRedundantAfterChars('def quicksort', '(arr):', '()')

Execute (UN-056 CountRedundantAfterChars: same case with a square bracket):
  AssertEqual 2, vim_ai_autocomplete#CountRedundantAfterChars('items', '[x, y]', '[]')

Execute (UN-057 CountRedundantAfterChars: "after" is not really an empty pair (there is content between the two) -> leaves it alone):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('def quicksort', '(arr):', '(x)')

Execute (UN-058 CountRedundantAfterChars: the suggestion does not use that kind of bracket -> plays it safe, returns 0):
  AssertEqual 0, vim_ai_autocomplete#CountRedundantAfterChars('def quicksort', 'pass', '()')
