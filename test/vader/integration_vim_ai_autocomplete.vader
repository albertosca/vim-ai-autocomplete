" IT-001 to IT-004: the <Tab> wrap preserving the original mapping.
" IT-001 simulates a pre-existing <expr> mapping INSIDE the test itself
" (instead of relying on a real CoC already loaded, as in ~/.vim_runtime)
" -- that keeps the suite 100% portable, with no third-party plugin required
" in the environment of whoever clones just this repo.

Execute (IT-001 SetupTabWrap preserves the old behaviour when there is no suggestion):
  inoremap <expr> <Tab> "'FAKE_ORIGINAL_TAB'"
  let original_map = maparg('<Tab>', 'i', 0, 1)
  Assert !empty(original_map), 'expected a pre-existing (simulated) <Tab> mapping'
  call vim_ai_autocomplete#SetupTabWrap()
  new
  call setline(1, 'foo')
  call cursor(1, 4)
  let result = vim_ai_autocomplete#TabHandler()
  let original_result = original_map.expr ? eval(original_map.rhs) : original_map.rhs
  AssertEqual original_result, result, 'with no visible suggestion, TabHandler should behave exactly like the original mapping'
After:
  bdelete!
  iunmap <Tab>

Execute (IT-002 TabHandler accepts the suggestion when visible, scheduling a direct buffer write):
  call vim_ai_autocomplete#SetupTabWrap()
  new
  call setline(1, 'def foo(')
  normal! G$
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    pass'])
  call feedkeys("a\<Tab>\<Esc>", 'x')
  AssertEqual 0, vim_ai_autocomplete#IsVisible(), 'Accept should clear the suggestion immediately'
  sleep 10m
  AssertEqual ['def foo(a, b):', '    pass'], getline(1, 2)
After:
  bdelete!

Execute (IT-002b Accept preserves the suggestion's exact indentation, without Vim's autoindent doubling it):
  call vim_ai_autocomplete#SetupTabWrap()
  new
  setlocal filetype=python
  setlocal autoindent smartindent
  call setline(1, 'def fibonacci(n):')
  normal! G$
  call vim_ai_autocomplete#ShowSuggestion(['if n <= 1:', '        return n', '    else:', '        return fibonacci(n - 1) + fibonacci(n - 2)'])
  call feedkeys("a\<Tab>\<Esc>", 'x')
  sleep 10m
  AssertEqual [
        \ 'def fibonacci(n):if n <= 1:',
        \ '        return n',
        \ '    else:',
        \ '        return fibonacci(n - 1) + fibonacci(n - 2)',
        \ ], getline(1, 4), 'each line indentation should match the suggestion text exactly, without Vim stacking indentation on top'
After:
  bdelete!

Execute (IT-002c Accept preserves the text after the cursor, moving it to the end of the last inserted line):
  new
  call setline(1, 'foobar')
  call cursor(1, 4)
  call vim_ai_autocomplete#ShowSuggestion(['XXX', 'YYY'])
  call vim_ai_autocomplete#TabHandler()
  sleep 10m
  AssertEqual ['fooXXX', 'YYYbar'], getline(1, 2)
  AssertEqual [2, 4], [line('.'), col('.')], 'the cursor should end right after the text inserted on the last line (before the preserved "bar")'
After:
  bdelete!

Execute (IT-002e Accept discards the redundant closer when the suggestion already closes its own parenthesis):
  " Simulates "def foo(" with the cursor between the parentheses auto-pairs
  " already inserted (real finding: "def sum(a, b):\n    return a + b)" --
  " the real ")" was left over at the end).
  call vim_ai_autocomplete#SetupTabWrap()
  new
  call setline(1, 'def foo()')
  call cursor(1, 8)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'], 1)
  call feedkeys("a\<Tab>\<Esc>", 'x')
  sleep 10m
  AssertEqual ['def foo(a, b):', '    return a + b'], getline(1, 2),
        \ 'the real ")" (redundant_after=1) should be discarded, not duplicated at the end'
After:
  bdelete!

Execute (IT-002f ShowSuggestion marks the redundant "after" with a highlight of its OWN (strikethrough), not the ghost text one):
  new
  call setline(1, 'def foo()')
  call cursor(1, 8)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'], 1)
  let props = prop_list(1)
  let redundant_prop = filter(copy(props), "v:val.type ==# 'VimAiAutocompleteRedundant' && v:val.col == 8 && get(v:val, 'length', 0) == 1")
  Assert !empty(redundant_prop), 'expected the VimAiAutocompleteRedundant prop covering the real ")" at col 8'
  let ghost_highlight_only = filter(copy(props), "v:val.type ==# 'VimAiAutocompleteSuggestion' && has_key(v:val, 'length')")
  Assert empty(ghost_highlight_only), 'the ghost text type (which implies inserting new text) should have no highlight-only use (without "text") -- that belongs to the Redundant type now'
After:
  call vim_ai_autocomplete#ClearSuggestion()
  bdelete!

Execute (IT-002g ClearSuggestion also removes the highlight of the redundant "after"):
  new
  call setline(1, 'def foo()')
  call cursor(1, 8)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'], 1)
  call vim_ai_autocomplete#ClearSuggestion()
  AssertEqual [], prop_list(1), 'ClearSuggestion should remove ALL props (ghost text and the redundant highlight)'
After:
  bdelete!

Execute (IT-002h Trigger invalidates the visible suggestion when the cursor moved away from where it was shown):
  " Real finding: moving the cursor with the arrows before accepting (Tab)
  " corrupted the buffer -- "def mergesortarr):" (the "(" vanished and an
  " extra ")" was left at the end). Root cause: Trigger() (called on every
  " CursorMovedI) only restarted the debounce, never invalidated an already
  " visible suggestion -- accepting a suggestion computed for a different
  " position writes everything in the wrong place.
  new
  call setline(1, 'def foo()')
  call cursor(1, 8)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'], 1)
  Assert vim_ai_autocomplete#IsVisible(), 'invalid setup: the suggestion should be visible'
  " simulates the cursor moving (e.g. left arrow) to BEFORE the "("
  call cursor(1, 7)
  call vim_ai_autocomplete#Trigger()
  AssertEqual 0, vim_ai_autocomplete#IsVisible(), 'Trigger should invalidate the suggestion when the cursor leaves where it was shown'
After:
  bdelete!

Execute (IT-002i Trigger does NOT invalidate the suggestion when the cursor is still at the same position):
  new
  call setline(1, 'def foo()')
  call cursor(1, 8)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    return a + b'], 1)
  " the cursor did not move -- Trigger should only restart the debounce, not
  " clear the suggestion already on screen
  call vim_ai_autocomplete#Trigger()
  Assert vim_ai_autocomplete#IsVisible(), 'Trigger should not invalidate the suggestion when the cursor did NOT move'
After:
  bdelete!

Execute (IT-002d Accept through the real <Tab> mapping does not throw E565 (changing the buffer during <expr> evaluation)):
  call vim_ai_autocomplete#SetupTabWrap()
  new
  setlocal filetype=python
  call setline(1, 'def fibonacci(n):')
  normal! G$
  call vim_ai_autocomplete#ShowSuggestion(['if n <= 1:', '        return n'])
  let threw = 0
  try
    call feedkeys("a\<Tab>\<Esc>", 'x')
  catch /E565/
    let threw = 1
  endtry
  AssertEqual 0, threw, 'accepting through a real <Tab> (not a direct :call) should not throw E565'
  sleep 10m
  AssertEqual ['def fibonacci(n):if n <= 1:', '        return n'], getline(1, 2)
After:
  bdelete!

Execute (IT-003 SetupProviderToggle registers ,pr and the command only with 2+ active models):
  let two_models = vim_ai_autocomplete#DefaultModels()
  call vim_ai_autocomplete#SetupProviderToggle(two_models)
  let map_both = maparg(',pr', 'n', 0, 1)
  Assert !empty(map_both), ',pr should be registered with 2+ active models'
  Assert exists(':VimAiAutocompleteModel'), ':VimAiAutocompleteModel should be registered with 2+ active models'

  nunmap ,pr
  delcommand VimAiAutocompleteModel
  call vim_ai_autocomplete#SetupProviderToggle([two_models[0]])
  let map_one = maparg(',pr', 'n', 0, 1)
  AssertEqual {}, map_one, ',pr should NOT be registered with only 1 active model'
  Assert !exists(':VimAiAutocompleteModel'), ':VimAiAutocompleteModel should NOT be registered with only 1 active model'

Execute (IT-004 ToggleProvider cycles through the active list, wrapping around at the end):
  let g:vim_ai_autocomplete_provider = 'gemini'
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'gemini', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT004_KEY_A'},
        \ {'name': 'claude', 'family': 'anthropic', 'model_id': 'y', 'api_key_env': 'IT004_KEY_B'},
        \ {'name': 'terceiro', 'family': 'gemini', 'model_id': 'z', 'api_key_env': 'IT004_KEY_C'},
        \ ]
  let $IT004_KEY_A = 'a'
  let $IT004_KEY_B = 'b'
  let $IT004_KEY_C = 'c'
  call vim_ai_autocomplete#ToggleProvider()
  AssertEqual 'claude', g:vim_ai_autocomplete_provider
  call vim_ai_autocomplete#ToggleProvider()
  AssertEqual 'terceiro', g:vim_ai_autocomplete_provider
  call vim_ai_autocomplete#ToggleProvider()
  AssertEqual 'gemini', g:vim_ai_autocomplete_provider, 'should wrap around to the first one after the last'
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT004_KEY_A
  unlet $IT004_KEY_B
  unlet $IT004_KEY_C

Execute (IT-005 the plugin no longer maps <Esc> in insert mode):
  " Root-cause regression: the old wrap swallowed <Esc> whenever a suggestion
  " was visible -- the user pressed <Esc> to leave insert mode, stayed in
  " insert mode, and the following keystrokes turned into buffer text.
  Assert !exists('*vim_ai_autocomplete#EscHandler'), 'EscHandler should no longer exist'
  Assert !exists('*vim_ai_autocomplete#SetupEscWrap'), 'SetupEscWrap should no longer exist'
  let esc_map = maparg('<Esc>', 'i', 0, 1)
  if !empty(esc_map)
    Assert stridx(get(esc_map, 'rhs', ''), 'vim_ai_autocomplete') < 0,
          \ 'the plugin may not hijack <Esc> in insert mode'
  endif
After:
  " This block opens no buffer and defines no global -- the empty After exists
  " so it does not inherit the previous one (Vader propagates the last After
  " defined to the following blocks).

Execute (IT-006 Dismiss discards the suggestion without leaving insert mode):
  new
  call setline(1, 'def foo(')
  call cursor(1, 9)
  call vim_ai_autocomplete#ShowSuggestion(['a, b):', '    pass'])
  AssertEqual 1, vim_ai_autocomplete#IsVisible(), 'precondition: the suggestion is visible'
  let result = vim_ai_autocomplete#Dismiss()
  AssertEqual '', result, 'Dismiss should return an empty string (it injects nothing into the buffer)'
  AssertEqual 0, vim_ai_autocomplete#IsVisible(), 'Dismiss should clear the suggestion'
After:
  bdelete!

Execute (IT-018 SplitDisplayTail: a suggestion closing its own parenthesis does not render ')' twice):
  " Ghost text is virtual text: every character pushes the real line to the
  " right. With the tail trimmed, the screen becomes exactly the final text.
  let [lines, ra] = vim_ai_autocomplete#SplitDisplayTail(['Continuous Integration)'], ')', 1)
  AssertEqual ['Continuous Integration'], lines, 'the ")" from the suggestion should leave the display'
  AssertEqual 0, ra, 'with no duplicated tail, nothing else needs discarding'

Execute (IT-019 SplitDisplayTail: a closer in the MIDDLE of the suggestion is not trimmed):
  let [lines, ra] = vim_ai_autocomplete#SplitDisplayTail(['x) { return; }'], ')', 1)
  AssertEqual ['x) { return; }'], lines, 'trimming the tail here would produce wrong text'
  AssertEqual 1, ra, 'keeps discarding the real ")", as before'

Execute (IT-020 SplitDisplayTail: the final accepted text does not change with the trim):
  for case in [[['Continuous Integration)'], ')', 1], [['hi")'], '")', 2], [['x) { return; }'], ')', 1], [['a,', '    b)'], ')', 1], [[')'], ')', 1]]
    let [lines, ra] = vim_ai_autocomplete#SplitDisplayTail(case[0], case[1], case[2])
    let before = join(case[0], "\n") . strpart(case[1], case[2])
    let after = join(lines, "\n") . strpart(case[1], ra)
    AssertEqual before, after, 'the trim must not change the final accepted text: ' . string(case)
  endfor

" IT-014a/b: ,pm model picker on the Vim side (parity with Neovim's
" vim.ui.select picker) -- popup_menu-based, registered only with 2+ active
" models, exactly like ,pr. OnModelPicked is the popup callback, split out
" so the selection logic is testable without a real popup.

Execute (IT-014a OnModelPicked: a valid 1-based index selects that model):
  let g:vim_ai_autocomplete_provider = 'a'
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'a', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT014_KEY_A'},
        \ {'name': 'b', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'IT014_KEY_B'},
        \ ]
  let $IT014_KEY_A = 'a'
  let $IT014_KEY_B = 'b'
  call vim_ai_autocomplete#OnModelPicked(['a', 'b'], 0, 2)
  AssertEqual 'b', g:vim_ai_autocomplete_provider
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT014_KEY_A
  unlet $IT014_KEY_B

Execute (IT-014b OnModelPicked: cancel (-1) and out-of-range leave the provider untouched):
  let g:vim_ai_autocomplete_provider = 'a'
  call vim_ai_autocomplete#OnModelPicked(['a', 'b'], 0, -1)
  AssertEqual 'a', g:vim_ai_autocomplete_provider
  call vim_ai_autocomplete#OnModelPicked(['a', 'b'], 0, 0)
  AssertEqual 'a', g:vim_ai_autocomplete_provider
  call vim_ai_autocomplete#OnModelPicked(['a', 'b'], 0, 99)
  AssertEqual 'a', g:vim_ai_autocomplete_provider
After:
  " own empty After so this block does not inherit IT-014a's unlets (Vader
  " propagates the last After defined to the following blocks)

Execute (IT-014c SetupProviderToggle registers ,pm with 2+ active models, and not with 1):
  let two_models = vim_ai_autocomplete#DefaultModels()
  call vim_ai_autocomplete#SetupProviderToggle(two_models)
  Assert !empty(maparg(',pm', 'n', 0, 1)), ',pm should be registered with 2+ active models'
  nunmap ,pm
  nunmap ,pr
  delcommand VimAiAutocompleteModel
  call vim_ai_autocomplete#SetupProviderToggle([two_models[0]])
  AssertEqual {}, maparg(',pm', 'n', 0, 1), ',pm should NOT be registered with only 1 active model'
After:
  " own empty After -- see IT-014b

Execute (IT-007 ,pt is registered by the plugin (the same mapping exists on the Neovim side)):
  let map = maparg(',pt', 'n', 0, 1)
  Assert !empty(map), ',pt should be registered (auto-trigger toggle, independent of any API key)'

Execute (IT-008 ToggleAutoTrigger flips g:vim_ai_autocomplete_auto_trigger):
  let g:vim_ai_autocomplete_auto_trigger = 1
  call vim_ai_autocomplete#ToggleAutoTrigger()
  AssertEqual 0, g:vim_ai_autocomplete_auto_trigger
  call vim_ai_autocomplete#ToggleAutoTrigger()
  AssertEqual 1, g:vim_ai_autocomplete_auto_trigger

Execute (IT-009 Trigger schedules no timer when auto-trigger is off):
  let g:vim_ai_autocomplete_auto_trigger = 0
  let before = len(timer_info())
  call vim_ai_autocomplete#Trigger()
  let after = len(timer_info())
  AssertEqual before, after, 'with auto-trigger off, Trigger should create no new timer'
After:
  let g:vim_ai_autocomplete_auto_trigger = 1

Execute (IT-010 SelectModel: a valid, active name switches the provider):
  let g:vim_ai_autocomplete_provider = 'gemini'
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'gemini', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT010_KEY_A'},
        \ {'name': 'claude', 'family': 'anthropic', 'model_id': 'y', 'api_key_env': 'IT010_KEY_B'},
        \ ]
  let $IT010_KEY_A = 'a'
  let $IT010_KEY_B = 'b'
  call vim_ai_autocomplete#SelectModel('claude')
  AssertEqual 'claude', g:vim_ai_autocomplete_provider
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT010_KEY_A
  unlet $IT010_KEY_B

Execute (IT-011 SelectModel: a name missing from the config -> error, provider unchanged):
  let g:vim_ai_autocomplete_provider = 'gemini'
  let g:vim_ai_autocomplete_models = [{'name': 'gemini', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT011_KEY_A'}]
  let $IT011_KEY_A = 'a'
  let threw = 0
  try
    call vim_ai_autocomplete#SelectModel('does-not-exist')
  catch
    let threw = 1
  endtry
  Assert threw, 'SelectModel with an invalid name should raise an error (echoerr)'
  AssertEqual 'gemini', g:vim_ai_autocomplete_provider, 'the provider should not change when the name is invalid'
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT011_KEY_A

Execute (IT-012 SelectModel: a name present in the config but with no active key -> error, provider unchanged):
  let g:vim_ai_autocomplete_provider = 'gemini'
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'gemini', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT012_KEY_A'},
        \ {'name': 'no-key', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'IT012_KEY_THAT_DOES_NOT_EXIST'},
        \ ]
  let $IT012_KEY_A = 'a'
  let threw = 0
  try
    call vim_ai_autocomplete#SelectModel('no-key')
  catch
    let threw = 1
  endtry
  Assert threw, 'SelectModel for a configured model with no active key should raise an error'
  AssertEqual 'gemini', g:vim_ai_autocomplete_provider
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT012_KEY_A

Execute (IT-013 CompleteModelNames: suggests only active names, filtering by arglead):
  let g:vim_ai_autocomplete_models = [
        \ {'name': 'gemini', 'family': 'gemini', 'model_id': 'x', 'api_key_env': 'IT013_KEY_A'},
        \ {'name': 'gpt-fake', 'family': 'gemini', 'model_id': 'y', 'api_key_env': 'IT013_KEY_WITH_NO_VALUE'},
        \ ]
  let $IT013_KEY_A = 'a'
  AssertEqual ['gemini'], vim_ai_autocomplete#CompleteModelNames('', '', 0)
  AssertEqual ['gemini'], vim_ai_autocomplete#CompleteModelNames('g', '', 0)
  AssertEqual [], vim_ai_autocomplete#CompleteModelNames('gpt', '', 0), 'gpt-fake is not active (no key), it should not show up'
After:
  unlet g:vim_ai_autocomplete_models
  unlet $IT013_KEY_A
